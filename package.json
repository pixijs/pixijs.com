{
  "name": "pixi-docusaurus",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "prebuild": "npm run generate",
    "build": "docusaurus build",
    "clear": "docusaurus clear",
    "predeploy": "npm run generate",
    "deploy": "docusaurus deploy",
    "docusaurus": "docusaurus",
    "lint": "eslint . --ext .js,.mjs,.jsx,.ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --fix --ext .js,.mjs,.jsx,.ts,.tsx",
    "prepare": "husky",
    "serve": "docusaurus serve",
    "prestart": "npm run generate",
    "start": "docusaurus start",
    "swizzle": "docusaurus swizzle",
    "sync:repos": "node ./scripts/sync-repos.mts",
    "vendor:pixi-3d": "node ./scripts/vendor-pixi-3d.mts",
    "pretypes": "npm run generate:code",
    "types": "tsc --noEmit",
    "write-heading-ids": "docusaurus write-heading-ids",
    "write-translations": "docusaurus write-translations",
    "generate": "npm run generate:code && npm run generate:content",
    "generate:code": "npm run generate:pixi && npm run generate:pixi-3d && npm run generate:runtime",
    "generate:pixi": "npm run sync:repos -- pixijs && npm run generate:docs && npm run generate:examples",
    "generate:docs": "node --disable-warning=ExperimentalWarning ./scripts/pixi-docs.mts",
    "generate:examples": "node --disable-warning=ExperimentalWarning ./scripts/examples.mts",
    "generate:pixi-3d": "npm run sync:repos -- pixi-3d && npm run generate:docs -- 3d && npm run generate:examples -- 3d",
    "generate:runtime": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/runtime.mts",
    "generate:example-previews": "node ./scripts/capture-example-previews.mjs",
    "generate:content": "node ./scripts/generate-tutorial-docs.mjs",
    "generate:sponsors": "node ./scripts/generate-sponsors.ts --experimental-strip-types"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --cache --fix"
    ],
    "*.{css,scss}": "prettier --write"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@docusaurus/core": "~3.10.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/plugin-client-redirects": "~3.10.2",
    "@docusaurus/plugin-content-blog": "~3.10.2",
    "@docusaurus/plugin-google-analytics": "~3.10.2",
    "@docusaurus/preset-classic": "~3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@gsap/react": "^2.1.2",
    "@mdx-js/react": "^3.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@pixi/3d": "file:vendor/pixi-3d.tgz",
    "@stackblitz/sdk": "^1.11.0",
    "clsx": "^2.1.1",
    "docusaurus-plugin-sass": "^0.2.7",
    "es-module-lexer": "^1.7.0",
    "fuse.js": "^7.5.0",
    "gsap": "^3.15.0",
    "pixi.js": "^8.22.0",
    "prism-react-renderer": "^2.4.1",
    "raw-loader": "^4.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.104.0",
    "sucrase": "^3.35.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^4.4.1",
    "axe-core": "^4.14.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "patch-package": "^8.0.1",
    "pixi-filters": "^6.1.5",
    "playwright": "1.64.0",
    "prettier": "^3.9.6",
    "recast": "^0.23.21",
    "sharp": "^0.34.5",
    "sponsorkit": "^17.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=24"
  }
}
